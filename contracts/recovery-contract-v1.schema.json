{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oxydavid-maxx/health-command-center/contracts/recovery-contract-v1.schema.json",
  "title": "Health Recovery Contract v1",
  "type": "object",
  "required": [
    "contract_version", "evaluation_date", "acquired_at", "source_digest",
    "lifecycle", "state", "confidence", "reason_codes", "plan_effect",
    "signals", "presentation"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "evaluation_date": { "type": "string", "format": "date" },
    "acquired_at": { "type": "string" },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lifecycle": { "enum": ["fresh", "pending", "stale", "partial", "error"] },
    "state": { "enum": ["good", "watch", "recover", "unknown"] },
    "confidence": { "enum": ["high", "medium", "low", "none"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "plan_effect": { "type": "string" },
    "signals": { "type": "object" },
    "presentation": {
      "type": "object",
      "required": ["action", "evidence", "freshness"],
      "properties": {
        "action": { "type": "string" },
        "evidence": { "type": "string" },
        "freshness": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
